DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/pk-hub
# Where archived workbooks (archives/) and the JSONL mirror (ppra/) are written.
DATA_DIR=../data

# Optional — the values below are the defaults. See README §6.
# SCRAPE_CONCURRENCY=3
# PUBLIC_BASE_URL=http://localhost:8000
# PPRA_DELAY_MIN_MS=1000
# PPRA_DELAY_MAX_MS=2500
# PPRA_LOCAL_MIRROR=true
# DNS_OVER_HTTPS=true

# Optional email of each finished workbook (AWS SES SMTP). Nothing is sent unless all are set.
# RECIPIENT_EMAILS=you@example.com,colleague@example.com
# AWS_REGION=us-east-1
# AWS_SES_FROM_EMAIL=
# AWS_SES_USERNAME=
# AWS_SES_PASSWORD=
